# ==========================================================================
# CampusRetain environment variables
# --------------------------------------------------------------------------
# Copy to .env for local development:   cp .env.example .env
# In production these are set in the Vercel project dashboard.
# NEVER commit a real .env file.
# ==========================================================================

# --- Core (required) ------------------------------------------------------

# Flask session signing key. Generate a strong one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app REFUSES TO BOOT in production if this is unset. Do not reuse the
# example value below.
SECRET_KEY=change-me-generate-a-real-random-value

# SQLAlchemy database URL.
#   Local dev  : sqlite:///campusretain.db
#   Production : postgresql://user:pass@host/dbname?sslmode=require   (Neon)
DATABASE_URL=sqlite:///campusretain.db

# Set to "production" on Vercel. Controls secure-cookie enforcement and
# whether missing configuration is fatal.
FLASK_ENV=development


# --- Access control -------------------------------------------------------

# Only email addresses on this domain may register.
ALLOWED_EMAIL_DOMAIN=ced.alliance.edu.in

# Administrator account.
# ADMIN_PASSWORD_HASH is a Werkzeug hash, NOT a plaintext password. Generate:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('your-password'))"
ADMIN_EMAIL=admin@ced.alliance.edu.in
ADMIN_PASSWORD_HASH=

# Flip to 1 to serve the maintenance page to non-admins during an upgrade.
MAINTENANCE_MODE=0


# --- Email (SMTP) ---------------------------------------------------------
# Gmail requires an App Password, not your account password.

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=CampusRetain Portal


# --- Image storage (Cloudinary) ------------------------------------------
# Leave CLOUDINARY_URL blank to fall back to local disk storage, which is fine
# for development but does NOT persist on Vercel's read-only filesystem.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>

CLOUDINARY_URL=


# --- SMS (Twilio, optional) ----------------------------------------------
# If unset, the app silently skips SMS and relies on email only.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_DEFAULT_COUNTRY_CODE=+91


# --- AI Architecture (Campus Retain AI) ----------------------------------
# Supported providers: google, openai, mock
AI_PROVIDER=google
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_TIMEOUT=15

