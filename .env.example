# Copy to .env for local development. Never commit .env.

# production | development | test   (defaults to production on Vercel, development elsewhere)
APP_ENV=development

# Required. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Required. Neon: use the *pooled* connection string, with sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Session length in hours (default 8). Students who tick "Keep me signed in" stay signed in
# for REMEMBER_DAYS instead (staff never do).
SESSION_HOURS=8
# REMEMBER_DAYS=30

# Email. MAIL_BACKEND=smtp sends real mail; console prints it (default in development).
MAIL_BACKEND=console
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=            # Gmail: an App Password, not your account password
MAIL_DEFAULT_FROM_NAME=Campus Retain

# Optional SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_DEFAULT_COUNTRY_CODE=+91

# Photo storage. With R2_BUCKET set, photos go to Cloudflare R2 (private bucket).
# Without it: "local" folder in development, photos kept in the database in production (2.0 behaviour).
# STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# LOCAL_MEDIA_DIR=instance/media

# Rate-limit storage. memory:// is per server instance; set REDIS_URL (e.g. Upstash
# rediss://default:PASS@HOST:6379) so limits are shared across serverless instances.
REDIS_URL=
# RATELIMIT_STORAGE_URI=   # overrides REDIS_URL if set

# Optional AI (Claude): photo-to-description and match checks. Off when empty.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_RATE_LIMIT=30 per hour

# Optional error monitoring (Sentry). Off when empty. No personal data is sent.
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# Optional browser push notifications. Generate with: flask --app app push vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Set to 1 when running behind a reverse proxy other than Vercel
TRUST_PROXY=0

# Show the maintenance page to students (staff still get in)
MAINTENANCE_MODE=0

# Tests (pytest)
TEST_DATABASE_URL=postgresql:///campus_retain_test
MIGRATION_TEST_DATABASE_URL=postgresql:///campus_retain_migtest

# Land signed-in users in the React app (/app/). 0 = classic pages.
USE_REACT_APP=1

# Daily pickup reminders (Vercel Cron sends this as a Bearer token). Off when empty.
# CRON_SECRET=
# PICKUP_REMINDER_DAYS=3
